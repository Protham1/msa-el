# Host-run defaults. Docker Compose sets its own container-internal URLs
# (for example http://gateway:8080 and jaeger:4318) in docker-compose.yml.
TRACEFLOW_API_PORT=8090
JAEGER_QUERY_URL=http://localhost:16686
GATEWAY_URL=http://localhost:8080
PAYMENT_SERVICE_URL=http://localhost:8083
INVENTORY_SERVICE_URL=http://localhost:8084
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4318
VITE_API_BASE_URL=http://localhost:8090
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
